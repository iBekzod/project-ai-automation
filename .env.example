# ============ Telegram ============
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user ID (get from @userinfobot)
TELEGRAM_DEVELOPER_ID=
# Comma-separated chat IDs of groups to monitor (e.g. -1001234567890,-1009876543210)
MONITORED_GROUP_IDS=

# ============ GitHub ============
GITHUB_TOKEN=
GITHUB_REPO=iBekzod/xonsaroy

# ============ Target repo ============
# Claude CLI is executed inside this directory.
REPO_PATH=D:/projects/Xonsaroy new/xonsaroy-latest

# ============ Branches ============
STAGE_BRANCH=stage
PROD_BRANCH=dev

# ============ Behaviour ============
# Optional keyword filter (comma-separated, case-insensitive). Empty = analyze every message.
# Example: bug,error,ishlamayapti,ne rabotaet,ошибка,не работает
TRIGGER_KEYWORDS=

# Safety switch: true = skip `git push`, PR creation, and merges. Flip to false only when ready.
DRY_RUN=true

# Path/command for Claude Code CLI (must be resolvable from bot's PATH).
CLAUDE_CLI=claude

# Seconds to wait for a single claude --print call before giving up.
# With CLAUDE.md + .ruflo/agents/*.yaml + 107 modules to search, Pass 1 often
# needs 3-10 minutes. 900s (15 min) is a safe default; bump higher if your repo
# is larger or slower.
CLAUDE_TIMEOUT=900

# Soft cap on concurrent Claude CLI invocations (across all chats + groups +
# classifiers). Default 5. Lower if you hit rate limits; raise if you have
# many parallel chats and a fast machine.
MAX_PARALLEL_CLAUDE=5
